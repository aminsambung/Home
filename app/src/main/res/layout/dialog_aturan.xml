<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buat Aturan Otomatis"
            android:textColor="@color/text_dark_light"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JIKA Lampu ini:"
            android:textColor="@color/text_dark_light"/>
            
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Spinner
                android:id="@+id/spinnerPemicu"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"/>
            <Spinner
                android:id="@+id/spinnerStatusPemicu"
                android:layout_width="120dp"
                android:layout_height="48dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAKA lakukan ini ke lampu terpilih:"
            android:textColor="@color/text_dark_light"
            android:layout_marginTop="16dp"/>

        <Spinner
            android:id="@+id/spinnerAksiTarget"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/layoutCheckboxTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnSimpanAturan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Aturan"
            android:backgroundTint="@color/hijau_primary"/>

    </LinearLayout>
</ScrollView>
