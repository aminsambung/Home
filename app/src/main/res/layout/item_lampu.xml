<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/bg_card"
    android:id="@+id/cardLampu">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Tombol Power Bulat -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnPower"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_power_button"
            android:src="@drawable/ic_power"
            android:padding="8dp"
            android:contentDescription="Toggle Lampu"/>

        <!-- Ikon Lampu Besar -->
        <TextView
            android:id="@+id/tvIkon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡"
            android:textSize="48sp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Nama dan Status Lampu -->
        <TextView
            android:id="@+id/tvNama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lampu 1"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_below="@id/tvIkon"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF"
            android:textColor="@color/text_off"
            android:textSize="12sp"
            android:layout_below="@id/tvNama"
            android:layout_alignParentStart="true"
            android:layout_marginTop="2dp"/>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
